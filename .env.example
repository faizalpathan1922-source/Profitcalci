# VITE_GEMINI_API_KEY / GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_ADMIN_PASSCODE_HASH: Optional pre-hashed (SHA-256) environment secret for admin verification.
# When provided, user input is hashed client-side with SHA-256 and verified directly against this secret.
# Example SHA-256 hash for a secure passcode.
VITE_ADMIN_PASSCODE_HASH=""

# VITE_ADMIN_SALT: Optional static salt used when generating VITE_ADMIN_PASSCODE_HASH.
VITE_ADMIN_SALT=""
